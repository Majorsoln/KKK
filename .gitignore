# ---------------------------------------------------------------------------
# DATA YA UTAFITI HAIINGII GIT (§9 ya DATA_FEATURE_STANDARD; lango G11)
# `research/` iko NDANI ya repo (uamuzi wa PD 2026-08-04) ili reports na code
# ya utafiti zisafiri na repo. `research/data/` PEKEE ndiyo haipushwi.
# Ni ignore ya FOLDA (si glob) — git haiingii ndani yake kabisa, kwa hiyo
# `git status` inabaki nyepesi hata ikiwa na GB 31 za ticks.
# ---------------------------------------------------------------------------
research/data/

# Sifa za mashine (nywila!) — env.example.bat PEKEE ndiyo inayopushwa
scripts/env.local.bat
*.local.bat

# Kina cha ubora: ~34 MB (checks 7 x siku ~39,000) na inabadilika kila run.
# Muhtasari (`quality_report.json`) ndio unaopushwa na kusainiwa; kina ni
# malighafi ya `quality-stats` na kinajengwa upya na `check-l1`.
quality_detail.json

# Cache za kuendelea baada ya kukatika — mstari mmoja kwa partition (~33 MB).
# Si ushahidi; zinajengwa upya na `build-calendar`/`check-l1`.
_calendar_scan.jsonl
_l1_scan.jsonl
_l2_state.json
audit.log

# Kinga ya pili (belt-and-braces): data ghafi popote ilipo
*.parquet
manifest_l0.json
freshness.json
